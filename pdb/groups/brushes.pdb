sub brushes_refresh {
    $blurb = 'Refresh current brushes. This function always succeeds.';

    $help = <<'HELP';
This procedure retrieves all brushes currently in the user's brush path
and updates the brush dialogs accordingly.
HELP

    &seth_pdb_misc('1997');

    %invoke = (
	code => <<'CODE'
{
  clay_data_factory_data_refresh (clay->brush_factory, context);
}
CODE
    );
}

sub brushes_get_list {
    $blurb = 'Retrieve a complete listing of the available brushes.';

    $help = <<'HELP';
This procedure returns a complete listing of available Clay
brushes.

Each brush returned can be used as input to [func@Clay.context_set_brush].
HELP

    &std_pdb_misc;

    @inargs = (
	{ name => 'filter', type => 'string',
          desc => 'An optional regular expression used to filter the list' }
    );

    @outargs = (
	{ name => 'brush_list', type => 'brusharray',
	  desc => 'The list of brushes' }
    );

    %invoke = (
        headers => [ qw("core/claycontainer-filter.h") ],
	code    => <<'CODE'
{
  brush_list = (ClayBrush **) clay_container_get_filtered_array (clay_data_factory_get_container (clay->brush_factory),
                                                                 filter);
}
CODE
    );
}

@headers = qw(<string.h>
              "core/clay.h"
              "core/claybrush.h"
              "core/claycontext.h"
              "core/claydatafactory.h"
              "core/claytempbuf.h"
              "claypdb-utils.h");

@procs = qw(brushes_refresh
            brushes_get_list);

%exports = (app => [@procs], lib => [@procs]);

$desc = 'Brushes';
$doc_title = 'claybrushes';
$doc_short_desc = 'Functions for manipulating brushes.';
$doc_long_desc = 'Functions related to getting and setting brushes.';

1;
