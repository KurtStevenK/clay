sub brushes_popup {
    $blurb = 'Invokes the Clay brush selection dialog.';
    $help  = 'Opens a dialog letting a user choose a brush.';

    &andy_pdb_misc('1998');

    @inargs = (
      { name => 'brush_callback', type => 'string', non_empty => 1,
        desc => 'The callback PDB proc to call when user chooses a brush' },
      { name => 'popup_title', type => 'string',
        desc => 'Title of the brush selection dialog' },
      { name => 'initial_brush', type => 'brush', none_ok => 1,
        desc => 'The brush to set as the initial choice' },
      { name => 'parent_window', type => 'bytes', none_ok => 1,
        desc => 'An optional parent window handle for the popup to be set transient to' }
    );

    %invoke = (
	code => <<'CODE'
{
  ClayContainer *container = clay_data_factory_get_container (clay->brush_factory);

  if (clay->no_interface ||
      ! clay_pdb_lookup_procedure (clay->pdb, brush_callback) ||
      ! clay_pdb_dialog_new (clay, context, progress,
                             clay_container_get_child_type (container),
                             parent_window, popup_title, brush_callback,
                             CLAY_OBJECT (initial_brush), NULL))
    success = FALSE;
}
CODE
    );
}

sub brushes_close_popup {
    $blurb = 'Close the brush selection dialog.';
    $help  = 'Closes an open brush selection dialog.';

    &andy_pdb_misc('1998');

    @inargs = (
      { name => 'brush_callback', type => 'string', non_empty => 1,
        desc => 'The name of the callback registered for this pop-up' }
    );

    %invoke = (
	code => <<'CODE'
{
  ClayContainer *container = clay_data_factory_get_container (clay->brush_factory);

  if (clay->no_interface ||
      ! clay_pdb_lookup_procedure (clay->pdb, brush_callback) ||
      ! clay_pdb_dialog_close (clay,
                               clay_container_get_child_type (container),
                               brush_callback))
    success = FALSE;
}
CODE
    );
}

sub brushes_set_popup {
    $blurb = 'Sets the selected brush in a brush selection dialog.';
    $help  = $blurb;

    &andy_pdb_misc('1998');

    @inargs = (
      { name => 'brush_callback', type => 'string', non_empty => 1,
        desc => 'The name of the callback registered for this pop-up' },
      { name => 'brush', type => 'brush',
        desc => 'The brush to set as selected' }
    );

    %invoke = (
	code => <<'CODE'
{
  ClayContainer *container = clay_data_factory_get_container (clay->brush_factory);

  if (clay->no_interface ||
      ! clay_pdb_lookup_procedure (clay->pdb, brush_callback) ||
      ! clay_pdb_dialog_set (clay,
                             clay_container_get_child_type (container),
                             brush_callback, CLAY_OBJECT (brush), NULL))
    success = FALSE;
}
CODE
    );
}


@headers = qw("core/clay.h"
              "core/claycontainer.h"
              "core/claydatafactory.h");

@procs = qw(brushes_popup
            brushes_close_popup
            brushes_set_popup);

%exports = (app => [@procs], lib => [@procs]);

$desc = 'Brush UI';
$doc_title = 'claybrushselect';
$doc_short_desc = 'Methods of a font chooser dialog';
$doc_long_desc = 'A dialog letting a user choose a brush.  Read more at clayfontselect.';

1;
