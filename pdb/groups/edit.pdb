sub edit_cut {
    $blurb = 'Cut from the specified drawables.';

    $help = <<'HELP';
If there is a selection in the image, then the area specified by the
selection is cut from the specified drawables and placed in an internal
Clay edit buffer. It can subsequently be retrieved using the
clay_edit_paste() command. If there is no selection and only one
specified drawable, then the specified drawable will be removed and its
contents stored in the internal Clay edit buffer.

This procedure will return %FALSE if the selected area lies completely
outside the bounds of the current drawables and there is nothing to cut
from.
HELP

    &std_pdb_misc;

    @inargs = (
        { name => 'drawables', type => 'drawablearray',
         desc => 'The drawables to cut from' }
    );

    @outargs = (
	{ name => 'non_empty', type => 'boolean',
	  desc => 'TRUE if the cut was successful,
                   FALSE if there was nothing to copy from' }
    );

    %invoke = (
	code => <<CODE
{
  ClayImage *image         = NULL;
  GList     *drawable_list = NULL;
  gint       i;

  for (i = 0; drawables[i] != NULL; i++)
    {
      if (! clay_pdb_item_is_attached (CLAY_ITEM (drawables[i]), NULL,
                                       CLAY_PDB_ITEM_CONTENT, error) ||
          ! clay_pdb_item_is_not_group (CLAY_ITEM (drawables[i]), error))
        {
          success = FALSE;
          break;
        }

      if (! image)
        {
          image = clay_item_get_image (CLAY_ITEM (drawables[i]));
        }
      else if (image != clay_item_get_image (CLAY_ITEM (drawables[i])))
        {
          success = FALSE;
          clay_message_literal (clay,
                                G_OBJECT (progress), CLAY_MESSAGE_WARNING,
                                _("All specified drawables must belong to the same image."));
          break;
        }

      drawable_list = g_list_prepend (drawable_list, (gpointer) drawables[i]);
    }

  if (success && image)
    {
      GError *my_error = NULL;

      non_empty = clay_edit_cut (image, drawable_list, context, &my_error) != NULL;

      if (! non_empty)
        {
          clay_message_literal (clay,
                                G_OBJECT (progress), CLAY_MESSAGE_WARNING,
                                my_error->message);
          g_clear_error (&my_error);
        }
    }
  else
    {
      success = FALSE;
    }
  g_list_free (drawable_list);
}
CODE
    );
}

sub edit_copy {
    $blurb = 'Copy from the specified drawables.';

    $help = <<'HELP';
If there is a selection in the image, then the area specified by the
selection is copied from the specified drawables and placed in an
internal Clay edit buffer. It can subsequently be retrieved using the
clay_edit_paste() command.  If there is no selection, then the
specified drawables' contents will be stored in the internal Clay edit
buffer.

This procedure will return %FALSE if the selected area lies
completely outside the bounds of the current drawables and there is
nothing to copy from.

All the drawables must belong to the same image.
HELP

    &std_pdb_misc;

    @inargs = (
	{ name => 'drawables', type => 'drawablearray',
          desc => 'Drawables to copy from' }
    );

    @outargs = (
	{ name => 'non_empty', type => 'boolean',
	  desc => 'TRUE if the cut was successful,
                   FALSE if there was nothing to copy from' }
    );

    %invoke = (
	code => <<CODE
{
  ClayImage *image          = NULL;
  GList     *drawables_list = NULL;
  gint       i;

  for (i = 0; drawables[i] != NULL; i++)
    {
      if (! clay_pdb_item_is_attached (CLAY_ITEM (drawables[i]), NULL, 0, error))
        {
          success = FALSE;
          break;
        }
      if (image == NULL)
        {
          image = clay_item_get_image (CLAY_ITEM (drawables[i]));
        }
      else if (image != clay_item_get_image (CLAY_ITEM (drawables[i])))
        {
          success = FALSE;
          break;
        }
      drawables_list = g_list_prepend (drawables_list, (gpointer) drawables[i]);
    }

  if (success && g_list_length (drawables_list) > 0)
    {
      GError *my_error = NULL;

      non_empty = clay_edit_copy (image, drawables_list, context, FALSE, &my_error) != NULL;

      if (! non_empty)
        {
          clay_message_literal (clay,
                                G_OBJECT (progress), CLAY_MESSAGE_WARNING,
                                my_error->message);
          g_clear_error (&my_error);
        }
    }
  else
    success = FALSE;

  g_list_free (drawables_list);
}
CODE
    );
}

sub edit_copy_visible {
    $blurb = 'Copy from the projection.';

    $help = <<'HELP';
If there is a selection in the image, then the area specified by the
selection is copied from the projection and placed in an internal Clay
edit buffer. It can subsequently be retrieved using the
clay_edit_paste() command. If there is no selection, then the
projection's contents will be stored in the internal Clay edit buffer.
HELP

    &mitch_pdb_misc('2004', '2.2');

    @inargs = (
	{ name => 'image', type => 'image',
	  desc => "The image to copy from" }
    );

    @outargs = (
	{ name => 'non_empty', type => 'boolean',
	  desc => 'TRUE if the copy was successful' }
    );

    %invoke = (
	code => <<CODE
{
  GError *my_error = NULL;

  non_empty = clay_edit_copy_visible (image, context, &my_error) != NULL;

  if (! non_empty)
    {
      clay_message_literal (clay,
                            G_OBJECT (progress), CLAY_MESSAGE_WARNING,
                            my_error->message);
      g_clear_error (&my_error);
    }
}
CODE
    );
}

sub edit_paste {
    $blurb = 'Paste buffer to the specified drawable.';

    $help = <<'HELP';
This procedure pastes a copy of the internal Clay edit buffer to the
specified drawable. The Clay edit buffer will be empty unless a call
was previously made to either [func@Clay.edit_cut] or [func@Clay.edit_copy].
The "paste_into" option specifies whether to clear the current image
selection, or to paste the buffer "behind" the selection. This allows
the selection to act as a mask for the pasted buffer. Anywhere that
the selection mask is non-zero, the pasted buffer will show
through.
The pasted data may be a floating selection when relevant, layers otherwise.
If the image has a floating selection at the time of pasting, the old
floating selection will be anchored to its drawable before the new
floating selection is added.

This procedure returns the new drawables (floating or not). If the result
is a floating selection, it will already be attached to the specified
drawable, and a subsequent call to [func@Clay.floating_sel_attach] is not needed.
HELP

    &std_pdb_misc;

    @inargs = (
	{ name => 'drawable', type => 'drawable',
	  desc => 'The drawable to paste to' },
        { name => 'paste_into', type => 'boolean',
	  desc => 'Clear selection, or paste behind it?' }
    );

    @outargs = (
        { name => 'new_drawables', type => 'drawablearray',
          desc => 'The list of pasted layers.' }
    );

    %invoke = (
	code => <<CODE
{
  ClayObject *paste = clay_get_clipboard_object (clay);

  if (paste &&
      clay_pdb_item_is_attached (CLAY_ITEM (drawable), NULL,
                                 CLAY_PDB_ITEM_CONTENT, error) &&
      clay_pdb_item_is_not_group (CLAY_ITEM (drawable), error))
    {
      GList *drawables = NULL;
      GList *list;
      gint   num_drawables;
      gint   i;

      if (drawable != NULL)
        drawables = g_list_prepend (drawables, drawable);

      list = clay_edit_paste (clay_item_get_image (CLAY_ITEM (drawable)),
                              drawables, paste,
                              paste_into ?
                              CLAY_PASTE_TYPE_FLOATING_INTO :
                              CLAY_PASTE_TYPE_FLOATING,
                              context, FALSE,
                              -1, -1, -1, -1);
      g_list_free (drawables);

      if (! list)
        success = FALSE;

      num_drawables = g_list_length (list);
      new_drawables = g_new0 (ClayDrawable *, num_drawables + 1);

      for (i = 0; i < num_drawables; i++, list = g_list_next (list))
        new_drawables[i] = g_object_ref (list->data);

      g_list_free (list);
    }
  else
    success = FALSE;
}
CODE
    );
}

sub edit_paste_as_new_image {
    $blurb = 'Paste buffer to a new image.';

    $help = <<'HELP';
This procedure pastes a copy of the internal Clay edit buffer to a new
image.  The Clay edit buffer will be empty unless a call was
previously made to either clay_edit_cut() or clay_edit_copy(). This
procedure returns the new image or -1 if the edit buffer was empty.
HELP

    &mitch_pdb_misc('2005', '2.10');

    @outargs = (
	{ name => 'image', type => 'image',
	  desc => 'The new image' }
    );
    %invoke = (
	code => <<CODE
{
  ClayObject *paste = clay_get_clipboard_object (clay);

  if (paste)
    {
      image = clay_edit_paste_as_new_image (clay, paste, context);

      if (! image)
        success = FALSE;
    }
}
CODE
    );
}

sub edit_named_cut {
    $blurb = 'Cut into a named buffer.';

    $help = <<'HELP';
This procedure works like clay_edit_cut(), but additionally stores the
cut buffer into a named buffer that will stay available for later
pasting, regardless of any intermediate copy or cut operations.
HELP

    &mitch_pdb_misc('2005', '2.4');

    @inargs = (
        { name => 'drawables', type => 'drawablearray',
         desc => 'The drawables to cut from' },
        { name => 'buffer_name', type => 'string', non_empty => 1,
          desc => 'The name of the buffer to create' }
    );

    @outargs = (
	{ name => 'real_name', type => 'string',
	  desc => 'The real name given to the buffer, or NULL if the
                   cut failed' }
    );

    %invoke = (
	code => <<CODE
{
  ClayImage *image         = NULL;
  GList     *drawable_list = NULL;
  gint       i;

  for (i = 0; drawables[i] != NULL; i++)
    {
      if (! clay_pdb_item_is_attached (CLAY_ITEM (drawables[i]), NULL,
                                       CLAY_PDB_ITEM_CONTENT, error) ||
          ! clay_pdb_item_is_not_group (CLAY_ITEM (drawables[i]), error))
        {
          success = FALSE;
          break;
        }

      if (! image)
        {
          image = clay_item_get_image (CLAY_ITEM (drawables[i]));
        }
      else if (image != clay_item_get_image (CLAY_ITEM (drawables[i])))
        {
          success = FALSE;
          clay_message_literal (clay,
                                G_OBJECT (progress), CLAY_MESSAGE_WARNING,
                                _("All specified drawables must belong to the same image."));
          break;
        }

      drawable_list = g_list_prepend (drawable_list, (gpointer) drawables[i]);
    }

  if (success && image)
    {
      GError *my_error = NULL;

      real_name = (gchar *) clay_edit_named_cut (image, buffer_name,
                                                 drawable_list, context, &my_error);

      if (real_name)
        {
          real_name = g_strdup (real_name);
        }
      else
        {
          clay_message_literal (clay,
                                G_OBJECT (progress), CLAY_MESSAGE_WARNING,
                                my_error->message);
          g_clear_error (&my_error);
        }
    }
  else
    {
      success = FALSE;
    }
  g_list_free (drawable_list);
}
CODE
    );
}

sub edit_named_copy {
    $blurb = 'Copy into a named buffer.';

    $help = <<'HELP';
This procedure works like clay_edit_copy(), but additionally stores the
copied buffer into a named buffer that will stay available for later
pasting, regardless of any intermediate copy or cut operations.
HELP

    &mitch_pdb_misc('2005', '2.4');

    @inargs = (
        { name => 'drawables', type => 'drawablearray',
         desc => 'The drawables to copy from' },
        { name => 'buffer_name', type => 'string', non_empty => 1,
          desc => 'The name of the buffer to create' }
    );

    @outargs = (
	{ name => 'real_name', type => 'string',
	  desc => 'The real name given to the buffer, or NULL if the
                   copy failed' }
    );

    %invoke = (
	code => <<CODE
{
  ClayImage *image         = NULL;
  GList     *drawable_list = NULL;
  gint       i;

  for (i = 0; drawables[i] != NULL; i++)
    {
      if (! clay_pdb_item_is_attached (CLAY_ITEM (drawables[i]), NULL,
                                       0, error))
        {
          success = FALSE;
          break;
        }

      if (! image)
        {
          image = clay_item_get_image (CLAY_ITEM (drawables[i]));
        }
      else if (image != clay_item_get_image (CLAY_ITEM (drawables[i])))
        {
          success = FALSE;
          clay_message_literal (clay,
                                G_OBJECT (progress), CLAY_MESSAGE_WARNING,
                                _("All specified drawables must belong to the same image."));
          break;
        }

      drawable_list = g_list_prepend (drawable_list, (gpointer) drawables[i]);
    }

  if (success && image)
    {
      GError *my_error = NULL;

      real_name = (gchar *) clay_edit_named_copy (image, buffer_name,
                                                  drawable_list, context, &my_error);

      if (real_name)
        {
          real_name = g_strdup (real_name);
        }
      else
        {
          clay_message_literal (clay,
                                G_OBJECT (progress), CLAY_MESSAGE_WARNING,
                                my_error->message);
          g_clear_error (&my_error);
        }
    }
  else
    {
      success = FALSE;
    }
  g_list_free (drawable_list);
}
CODE
    );
}

sub edit_named_copy_visible {
    $blurb = 'Copy from the projection into a named buffer.';

    $help = <<'HELP';
This procedure works like clay_edit_copy_visible(), but additionally
stores the copied buffer into a named buffer that will stay available
for later pasting, regardless of any intermediate copy or cut
operations.
HELP

    &mitch_pdb_misc('2005', '2.4');

    @inargs = (
	{ name => 'image', type => 'image',
	  desc => "The image to copy from" },
        { name => 'buffer_name', type => 'string', non_empty => 1,
          desc => 'The name of the buffer to create' }
    );

    @outargs = (
	{ name => 'real_name', type => 'string',
	  desc => 'The real name given to the buffer, or NULL if the
                   copy failed' }
    );

    %invoke = (
	code => <<CODE
{
  GError *my_error = NULL;

  real_name = (gchar *) clay_edit_named_copy_visible (image, buffer_name,
                                                      context, &my_error);

  if (real_name)
    {
      real_name = g_strdup (real_name);
    }
  else
    {
      clay_message_literal (clay,
                            G_OBJECT (progress), CLAY_MESSAGE_WARNING,
                            my_error->message);
      g_clear_error (&my_error);
    }
}
CODE
    );
}

sub edit_named_paste {
    $blurb = 'Paste named buffer to the specified drawable.';

    $help = <<'HELP';
This procedure works like clay_edit_paste() but pastes a named buffer
instead of the global buffer.
HELP

    &mitch_pdb_misc('2005', '2.4');

    @inargs = (
	{ name => 'drawable', type => 'drawable',
	  desc => 'The drawable to paste to' },
        { name => 'buffer_name', type => 'string',
          desc => 'The name of the buffer to paste' },
        { name => 'paste_into', type => 'boolean',
	  desc => 'Clear selection, or paste behind it?' }
    );

    @outargs = (
	{ name  => 'floating_sel', type  => 'layer',
	  desc  => 'The new floating selection' }
    );

    %invoke = (
	code => <<CODE
{
  ClayBuffer *buffer = clay_pdb_get_buffer (clay, buffer_name, error);

  if (buffer &&
      clay_pdb_item_is_attached (CLAY_ITEM (drawable), NULL,
                                 CLAY_PDB_ITEM_CONTENT, error) &&
      clay_pdb_item_is_not_group (CLAY_ITEM (drawable), error))
    {
      GList *drawables = NULL;
      GList *layers;

      if (drawable != NULL)
        drawables = g_list_prepend (drawables, drawable);

      layers = clay_edit_paste (clay_item_get_image (CLAY_ITEM (drawable)),
                                drawables, CLAY_OBJECT (buffer),
                                paste_into ?
                                CLAY_PASTE_TYPE_FLOATING_INTO :
                                CLAY_PASTE_TYPE_FLOATING,
                                context, FALSE,
                                -1, -1, -1, -1);
      g_list_free (drawables);

      if (! layers)
        success = FALSE;
      else
        floating_sel = layers->data;

      g_list_free (layers);
    }
  else
    success = FALSE;
}
CODE
    )
}

sub edit_named_paste_as_new_image {
    $blurb = 'Paste named buffer to a new image.';

    $help = <<'HELP';
This procedure works like clay_edit_paste_as_new_image() but pastes a
named buffer instead of the global buffer.
HELP

    &mitch_pdb_misc('2005', '2.10');

    @inargs = (
        { name => 'buffer_name', type => 'string',
          desc => 'The name of the buffer to paste' }
    );

    @outargs = (
	{ name => 'image', type => 'image',
	  desc => 'The new image' }
    );

    %invoke = (
	code => <<CODE
{
  ClayBuffer *buffer = clay_pdb_get_buffer (clay, buffer_name, error);

  if (buffer)
    {
      image = clay_edit_paste_as_new_image (clay, CLAY_OBJECT (buffer), context);

      if (! image)
        success = FALSE;
    }
  else
    success = FALSE;
}
CODE
    );
}


@headers = qw("libclayconfig/clayconfig.h"
              "core/clay.h"
              "core/clay-edit.h"
              "core/claydrawable-edit.h"
              "core/claybuffer.h"
              "core/clayimage.h"
              "core/clayprogress.h"
              "claypdb-utils.h"
              "claypdbcontext.h"
              "clay-intl.h");

@procs = qw(edit_cut
            edit_copy
            edit_copy_visible
            edit_paste
            edit_paste_as_new_image
            edit_named_cut
            edit_named_copy
            edit_named_copy_visible
            edit_named_paste
            edit_named_paste_as_new_image);

%exports = (app => [@procs], lib => [@procs]);

$desc = 'Edit procedures';
$doc_title = 'clayedit';
$doc_short_desc = 'Edit menu functions (cut, copy, paste, clear, etc.)';
$doc_long_desc = 'Edit menu functions (cut, copy, paste, clear, etc.)';

1;
