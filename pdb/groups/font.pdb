# The invoke code is compiled on the app side.
# The invoke code must assign to each result var

sub font_get_by_name {
    $blurb = "Returns a font with the given name.";
    $help = <<'HELP';
If several fonts are named identically, the one which is returned by this
function should be considered random. This can be used when you know you won't
have multiple fonts of this name or that you don't want to choose
(non-interactive scripts, etc.).

If you need more control, you should use [func@fonts_get_list] instead.

Returns %NULL when no font exists of that name.
HELP

    &mitch_pdb_misc('2023', '3.0');

    @inargs = (
      { name => 'name', type => 'string', non_empty => 1,
        desc => 'The name of the font' }
    );

    @outargs = (
      { name => 'font',
        type => 'font',
        desc => 'The font',
        none_ok => 1 }
    );

    %invoke = (
        code => <<'CODE'
{
  font = CLAY_FONT (clay_pdb_get_resource (clay, CLAY_TYPE_FONT, name, CLAY_PDB_DATA_ACCESS_READ, error));
  /* Ignore "not found" error, just return NULL. */
  g_clear_error (error);
}
CODE
    );
}

sub font_get_by_postscript_name {
    $blurb = "Returns a font with the given PostScript name.";
    $help = <<'HELP';
If several fonts are named identically, the one which is returned by this
function should be considered random. This can be used when you know you won't
have multiple fonts of this name or that you don't want to choose
(non-interactive scripts, etc.).

If you need more control, you should use [func@fonts_get_list] instead.

Returns %NULL when no font exists of that name.
HELP

    &alxsa_pdb_misc('2026', '3.4');

    @inargs = (
      { name => 'psname', type => 'string', non_empty => 1,
        desc => 'The PostScript name of the font' }
    );

    @outargs = (
      { name => 'font',
        type => 'font',
        desc => 'The font',
        none_ok => 1 }
    );

    %invoke = (
        code => <<'CODE'
{
    ClayContainer *fonts_container;

    fonts_container = clay_data_factory_get_container (clay->font_factory);

    font = CLAY_FONT (clay_container_search (fonts_container,
                                             (ClayContainerSearchFunc) clay_font_match_by_postscript_name,
                                             (gpointer) psname));
    /* Ignore "not found" error, just return NULL. */
    g_clear_error (error);
}
CODE
    );
}

sub font_get_lookup_name {
    $blurb = 'Retrieve the font lookup name.';

    $help = <<'HELP';
Retrieve the font lookup name.
HELP

    &idriss_pdb_misc('2023', '3.0');

    $lib_private = 1;

    @inargs = (
      { name => 'font', type => 'font',
        desc => 'ClayFont object' }
    );

    @outargs = (
      { name => 'lookup_name', type => 'string',
        desc => 'font lookup name' }
    );

    %invoke = (
	code => <<'CODE'
{
    lookup_name = g_strdup (clay_font_get_lookup_name (font));
}
CODE
    );
}

@headers = qw("core/clay.h"
              "core/claycontainer.h"
              "core/claydatafactory.h"
              "text/clayfont.h"
              "claypdb-utils.h");

@procs = qw(font_get_lookup_name font_get_by_name
            font_get_by_postscript_name);

%exports = (app => [@procs], lib => [@procs]);

$desc = 'Font';
$doc_title = 'clayfont';
$doc_short_desc = 'Installable object used by text tools.';
$doc_long_desc = 'Installable object used by text tools.';

1;
