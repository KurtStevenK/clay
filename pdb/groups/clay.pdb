sub version {
    $blurb = 'Returns the host Clay version.';

    $help = <<'HELP';
This procedure returns the version number of the currently running Clay.
HELP

    &yosh_pdb_misc('1999');

    @outargs = (
	{ name => 'version', type => 'string',
	  desc => 'Clay version number' }
    );

    %invoke = (
	headers => [ qw("libclaybase/claybase.h") ],
	code    => <<'CODE'
{
  version = g_strdup (CLAY_VERSION);
}
CODE
    );
}

sub getpid {
    $blurb = 'Returns the PID of the host Clay process.';

    $help = <<'HELP';
This procedure returns the process ID of the currently running Clay.
HELP

    &mitch_pdb_misc('2005', '2.4');

    @outargs = (
	{ name => 'pid', type => 'int32',
	  desc => 'The PID' }
    );

    %invoke = (
	headers => [ qw("core/clay-utils.h") ],
	code    => <<'CODE'
{
  pid = clay_get_pid ();
}
CODE
    );
}

sub quit {
    $blurb = 'Causes Clay to exit gracefully.';

    $help = <<'HELP';
If there are unsaved images in an interactive Clay session, the user
will be asked for confirmation. If force is TRUE, the application is
quit without querying the user to save any dirty images.


This procedure is deprecated without any replacement. Scripts and
plug-ins should not request the main process to exit. If you wish to run
Clay non-interactively so that it exits immediately when the batch
script ends, call the executable with option `--quit`.
HELP

    &std_pdb_misc;

    $deprecated = 'NONE';
    $deprecated_since = '3.2.4';

    @inargs = (
	{ name => 'force', type => 'boolean',
	  desc => 'Force Clay to quit without asking' }
    );

    %invoke = (
	code => <<'CODE'
{
  clay_exit (clay, force);
}
CODE
    );
}

sub attach_parasite {
    $blurb = 'Add a global parasite.';

    $help = <<'HELP';
This procedure attaches a global parasite. It has no return values.
HELP

    &jay_pdb_misc('1998', '2.8');

    @inargs = (
	{ name => 'parasite', type => 'parasite',
	  desc => 'The parasite to attach' }
    );

    %invoke = (
	code => <<'CODE'
{
  if (clay_parasite_validate (clay, parasite, error))
    clay_parasite_attach (clay, parasite);
  else
    success = FALSE;
}
CODE
    );
}

sub detach_parasite {
    $blurb = 'Removes a global parasite.';

    $help = <<'HELP';
This procedure detaches a global parasite.


It will return %FALSE if @name is invalid (%NULL or empty string) and
%TRUE otherwise (even if there was no parasite removed, because no
parasite was named like this).
HELP

    &jay_pdb_misc('1998', '2.8');

    @inargs = (
	{ name => 'name', type => 'string',
	  desc => 'The name of the parasite to detach.' }
    );

    %invoke = (
	code => <<'CODE'
{
  if (name && strlen (name) > 0)
    clay_parasite_detach (clay, name);
  else
    success = FALSE;
}
CODE
    );
}

sub get_parasite {
    $blurb = 'Look up a global parasite.';

    $help = <<'HELP';
Finds and returns the global parasite that was previously attached.
HELP

    &jay_pdb_misc('1998', '2.8');

    @inargs = (
	{ name => 'name', type => 'string',
	  desc => 'The name of the parasite to find' }
    );

    @outargs = (
	{ name => 'parasite', type => 'parasite',
	  desc => 'The found parasite' }
    );

    %invoke = (
	code => <<'CODE'
{
  parasite = clay_parasite_copy (clay_parasite_find (clay, name));

  if (! parasite)
    success = FALSE;
}
CODE
    );
}

sub get_parasite_list {
    $blurb = 'List all parasites.';
    $help  = 'Returns a list of all currently attached global parasites.';

    &marc_pdb_misc('1999', '2.8');

    @outargs = (
	{ name => 'parasites', type => 'strv',
	  desc => 'The names of currently attached parasites' }
    );

    %invoke = (
	code => <<'CODE'
{
  parasites = clay_parasite_list (clay);
}
CODE
    );
}

sub temp_file {
    $blurb = 'Generates a unique temporary file.';

    $help = <<'HELP';
Generates a unique file using the temp path supplied in the user's clayrc.
HELP

    &josh_pdb_misc('1997');

    @inargs = (
        { name => 'extension', type => 'string',
	  allow_non_utf8 => 1, none_ok => 1,
          desc => 'The extension the file will have' }
    );

    @outargs = (
        { name => 'file', type => 'file',
          desc => 'The new temp file' }
    );

    %invoke = (
        code => <<'CODE'
{
  file    = clay_get_temp_file (clay, extension, error);
  success = (file != NULL);
}
CODE
    );
}


@headers = qw("core/clay.h"
              "core/clay-parasites.h");

@procs = qw(version
            getpid
            quit
            attach_parasite
            detach_parasite
            get_parasite
            get_parasite_list
            temp_file);

%exports = (app => [@procs], lib => [@procs[0..1,3..7]]);

$desc = 'Clay';
$doc_title = 'clay';
$doc_short_desc = 'Main functions needed for building a Clay plug-in.';
$doc_long_desc = <<'DESC';
Main functions needed for building a Clay plug-in.
This header includes all other Clay Library headers.

Also contains some miscellaneous procedures that don't fit in any
other category.
DESC

1;
