# Copy to .env.local (gitignored). Used by scripts/virustotal-scan.mjs
# (npm run scan:virustotal). Never commit real values.

# VirusTotal — https://www.virustotal.com/gui/my-apikey (same key as FeatherShot)
VIRUSTOTAL_API_KEY=

# Set to 1 to exit non-zero when any engine reports malicious (default: warn only)
# VIRUSTOTAL_FAIL_ON_DETECTION=0

# Minutes to wait for queued analyses before reporting them as pending (default 45)
# VIRUSTOTAL_WAIT_MINUTES=45
