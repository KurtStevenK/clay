# Clay tool preset file

(icon-name "clay-tool-paintbrush")
(name "Structure")
(tool-options "ClayPaintOptions"
    (tool "clay-paintbrush-tool")
    (brush "Structure")
    (dynamics "Perspective")
    (gradient "FG to BG (RGB)")
    (brush-size 283.550000))
(use-fg-bg no)
(use-brush yes)
(use-dynamics yes)
(use-gradient yes)
(use-pattern yes)
(use-palette yes)
(use-font yes)

# end of Clay tool preset file
