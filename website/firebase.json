{
  "hosting": {
    "site": "claydesign",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/docs", "destination": "/docs.html" },
      { "source": "/tutorials", "destination": "/tutorials.html" },
      { "source": "/contributing", "destination": "/contributing.html" },
      { "source": "/donate", "destination": "/donate.html" }
    ]
  }
}
