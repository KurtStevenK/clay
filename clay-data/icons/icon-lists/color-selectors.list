# grep -rI icon_name modules/color-selector-*
#
# Color selector modules whose icon is used in:
# - ClayColorEditor as GTK_ICON_SIZE_MENU (16px)
# - ClayColorNotebook:
#   * tab-icon-size style tab label (button size both in
#     DEFAULT_TAB_ICON_SIZE amd System theme, i.e. 16px.).
#   * menu size (16px)
#   * DEFAULT_TAB_ICON_SIZE (button, 16px)

clay-color-cmyk
clay-color-triangle
clay-color-water

# CLAY_ICON_PALETTE, which is the default icon of ClayColorSelector.
gtk-select-color
# CLAY_ICON_WILBER, overriden by ClayColorSelect subclass.
clay-wilber
# CLAY_ICON_DIALOG_TOOL_OPTIONS overriden by ClayColorScales subclass.
clay-tool-options
