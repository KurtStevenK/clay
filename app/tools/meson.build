libapptools = static_library('apptools',
  libapptools_sources,
  include_directories: [ rootInclude, rootAppInclude, ],
  c_args: '-DG_LOG_DOMAIN="Clay-Tools"',
  dependencies: [
    gegl, gtk3, gexiv2,
  ],
)
