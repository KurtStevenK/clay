  libappcore_sources,
  include_directories: [ rootInclude, rootAppInclude, ],
  c_args: [
    '-DG_LOG_DOMAIN="Clay-Core"',
    '-Wno-deprecated-declarations',
  ],
  dependencies: [
    cairo,
    gegl,
    gdk_pixbuf,
    libarchive,
    libmypaint,
    gexiv2,
    appstream,
    json_glib,
    math,
    dl,
    libunwind,
    pango,
  ],
)
