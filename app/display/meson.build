stamp_display_enums = custom_target('stamp-display-enums.h',
  input : [
    files(
      'display-enums.h'
    ),
  ],
  output: [ 'stamp-display-enums.h', ],
  command: [
    mkenums_wrap, perl,
    meson.project_source_root(), meson.current_source_dir(),
    meson.current_build_dir(),
    'display-',
    '#include <gio/gio.h>\n'              +
    '#include "libclaybase/claybase.h"\n',
    '#include "clay-intl.h"'
  ],
  build_by_default: true
)

libappdisplay_sources = [
  'claycanvas-style.c',
  'claycanvas.c',
  'claycanvasarc.c',
  'claycanvasboundary.c',
  'claycanvasbufferpreview.c',
