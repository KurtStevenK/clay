  'claycanvasitem-utils.c',
  'claycanvasitem.c',
  'claycanvaslayerboundary.c',
  'claycanvaslimit.c',
  'claycanvasline.c',
  'claycanvaspassepartout.c',
  'claycanvaspath.c',
  'claycanvaspen.c',
  'claycanvaspolygon.c',
  'claycanvasprogress.c',
  'claycanvasproxygroup.c',
  'claycanvasrectangle.c',
  'claycanvasrectangleguides.c',
  'claycanvassamplepoint.c',
  'claycanvastextcursor.c',
  'claycanvastransformguides.c',
  'claycanvastransformpreview.c',
  'claycanvastext.c',
  'claycanvastext.h',
  'claycursorview.c',
  'claydisplay-foreach.c',
  'claydisplay-handlers.c',
  'claydisplay.c',
  'claydisplayshell-actions.c',
  'claydisplayshell-appearance.c',
  'claydisplayshell-autoscroll.c',
  'claydisplayshell-callbacks.c',
  'claydisplayshell-close.c',
  'claydisplayshell-cursor.c',
  'claydisplayshell-dnd.c',
  'claydisplayshell-draw.c',
  'claydisplayshell-expose.c',
  'claydisplayshell-filter-dialog.c',
  'claydisplayshell-filter.c',
  'claydisplayshell-grab.c',
  'claydisplayshell-handlers.c',
  'claydisplayshell-items.c',
  'claydisplayshell-layer-select.c',
  'claydisplayshell-profile.c',
  'claydisplayshell-progress.c',
  'claydisplayshell-render.c',
  'claydisplayshell-rotate-dialog.c',
  'claydisplayshell-rotate.c',
  'claydisplayshell-rulers.c',
  'claydisplayshell-scale-dialog.c',
  'claydisplayshell-scale.c',
  'claydisplayshell-scroll.c',
  'claydisplayshell-scrollbars.c',
  'claydisplayshell-selection.c',
  'claydisplayshell-title.c',
  'claydisplayshell-tool-events.c',
  'claydisplayshell-transform.c',
  'claydisplayshell-utils.c',
  'claydisplayshell.c',
  'claymodifiersmanager.c',
  'clayimagewindow.c',
  'claymotionbuffer.c',
  'claymultiwindowstrategy.c',
  'claynavigationeditor.c',
  'clayscalecombobox.c',
  'claysinglewindowstrategy.c',
  'claystatusbar.c',
  'claytoolcompass.c',
  'claytooldialog.c',
