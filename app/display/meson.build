  'claytoolwidget.c',
  'claytoolwidgetgroup.c',

  'display-enums.c',
  stamp_display_enums,

  gitversion_h,

  appcoremarshal[1],
]

libappdisplay = static_library('appdisplay',
  libappdisplay_sources,
  include_directories: [ rootInclude, rootAppInclude, ],
  c_args: '-DG_LOG_DOMAIN="Clay-Display"',
  dependencies: [
    gegl, gtk3, cairo, gexiv2
  ],
)
